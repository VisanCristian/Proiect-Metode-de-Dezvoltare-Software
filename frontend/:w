export default function FileTree() {
    const [currentFolder, setCurrentFolder] = useState(null);

    const folders = getUserFolders(1);

    return (
        <>
            <h1>File Storage</h1>
            <AddFile />
            <div className="folder-tree">
                {
                    currentFolder === null ? (
                        folders.map(folder => (
                            <Folder
                                key={folder.id}
                                folder_name={folder.name}
                                onClick={() => setCurrentFolder(folder_name)}
                            />
                        ))
                    ) : (
                        <div className="file-tree">
                            <button className="return-button" onClick={() => setCurrentFolder(null)} > Return </button>
                        </div>
                    )
                }
            </div>

        </>
    );
}
